    },
    "Tables, formulas and charts (full size)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表格、公式和图表（完整版）"
          }
        }
      }
    },
    "Tables, formulas, charts, seals and low-confidence regions. Without it, these are only flagged for review" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表格、公式、图表、印章，以及置信度低的区域；未安装时只标记待复核"
          }
        }
      }
    },
