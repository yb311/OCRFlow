        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一张长图"
          }
        }
      }
    },
    "Only affects how the Markdown tab displays; the Source tab always shows the model's raw output. Other engines produce plain text and are not affected." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅影响“Markdown”标签页的显示方式；“源码”标签页始终是模型输出的原文。其他引擎只有纯文本，不受这里影响。"
          }
        }
      }
    },
    "Only affects results recognized from now on; existing ones are not changed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只影响之后识别的结果，已有结果不变。"
