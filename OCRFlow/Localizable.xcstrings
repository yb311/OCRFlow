    "Welcome to OCRFlow" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎使用 OCRFlow"
          }
        }
      }
    },
    "What a recording or a queue of screenshots took, saved together. When off, each page is saved as a picture" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制或队列截图得到的多页一起保存时。关闭后每页各存为一张图片"
          }
        }
      }
    },
    "What frames a page rather than being part of it. Ticked items go into the results; the rest are left out. Footnotes are kept by default." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页面四周的辅助内容，而不是正文。勾选的会放进结果，其余不放。脚注默认保留。"
          }
        }
      }
    },
    "What to Recognize" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "识别内容"
          }
        }
      }
    },
    "When a PDF already has a text layer" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 已有文字层时"
          }
        }
      }
    },
    "When a run ends, you choose whether they are recognized, only saved, or discarded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次运行结束时，由你选择识别、只保存还是丢弃。"
          }
        }
      }
    },
    "When off, tables are shown as the model output them" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后按模型输出的原始形式显示表格"
          }
        }
      }
    },
    "When on, each file's content starts with a level-1 heading" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，每个文件的内容以一级标题开头"
          }
        }
      }
    },
    "When on, each file's content starts with a “=== file name ===” line" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，每个文件的内容前会加上“=== 文件名 ===”一行"
          }
        }
      }
    },
    "When you click Start Recognition again, files already recognized are not processed again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新点击“开始识别”时，不重复处理已识别的文件"
          }
        }
      }
    },
    "Whether headers, footers, page numbers and other auxiliary content on this page go into the result (dashed boxes are excluded)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一页上的页眉/页脚/页码等辅助内容要不要写进结果（虚线框表示已排除）"
          }
        }
      }
    },
    "Whole page" : {
