          }
        }
      }
    },
    "Straightens skewed, curled or folded pages, such as a phone photo of a book. Scans don't need it, and it takes extra time" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把歪斜、卷曲或折叠的页面拉平，例如用手机拍的书页。扫描件不需要，开启会多花时间"
          }
        }
      }
    },
    "Switching tiers resets the detection thresholds to that tier's official defaults." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换档位会把检测阈值恢复为该档位的官方默认值。"
