            "value" : "页眉图"
          }
        }
      }
    },
    "Headers, footers, page numbers and the like are detected by the layout model and filtered out by default. Turn an item on to keep it in the results. Matches PaddleOCR's official auxiliary content options." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页眉、页脚、页码这类内容会被版面模型认出来并默认过滤掉；打开某一项表示把它保留在结果里。与 PaddleOCR 官方的「辅助内容解析」一一对应。"
          }
        }
      }
    },
    "Heading level detection" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "段落标题级别识别"
          }
        }
      }
