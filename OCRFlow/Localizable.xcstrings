      }
    },
    "GPU models batch regions from several files and pages and decode them together. Two files at a time is enough to keep the GPU busy; more only uses more memory." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU 模型会把多个文件、多个页面的区域合并成批一起解码，最多同时处理 2 个文件就足以让 GPU 满载，再多只会多占内存。"
          }
        }
      }
    },
    "German" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "德文"
          }
        }
